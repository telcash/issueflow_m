{#
    Fragmento reutilizable para representar una incidencia dentro de un listado.
    El guion bajo inicial es una convención habitual para indicar que este archivo
    es un partial y no una página completa.
#}
<article class="ticket-card">
    <div>
        <p class="ticket-id">{{ ticket.id }}</p>
        <h2>{{ ticket.title }}</h2>
        <p>Prioridad: <strong>{{ ticket.priority.value }}</strong></p>
        <p>Estado: <strong>{{ ticket.status }}</strong></p>
        {# Agregamos un enlace a la vista particular de este ticket #}
        <a href="{{ path('app_ticket_show', { id: ticket.id }) }}">Ver detalle</a>
    </div>
</article>