{#  Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# Sobreescribir el título #}
{% block title %}{{ title }}{% endblock %}

{# Inserto el cuerpo de la página de /tickets: el listado de todos los tickets #}
{% block body %}
    <div class="page-header">
        <div>
            <p class="eyebrow">IssueFlow</p>
            <h1>{{ title }}</h1>
        </div>
        {#
            is_granted() devuelve true si hay un usuario autenticado con el rol solicitado
        #}
        {% if is_granted('ROLE_AGENT') %}
            <a href="{{ path('app_ticket_new') }}">Nueva incidencia</a>
        {% endif %}
        {#
            ticketPage será suministrado por el contralador, es un objeto WindowPage
            getTotalCount() devuelve la cantidad de tickets totales
        #}
        <p class="counter">{{ ticketPage.getTotalCount() }} incidencias</p>  
    </div>
    {#
        Es un formulario o filtro GET, filtar no modifica el estado del servidor.
        Sus valores quedan visibles y compartibles en la URL
    #}
    <section class="filter-card">
        {# Inicio del formulario de filtrado #} 
        {{ form_start(filterForm, { attr: { class: 'filter-form'} }) }}
            {# Campos de entrada del formulario de filtrado #}
            {{ form_row(filterForm.query) }}
            {{ form_row(filterForm.priority) }}
            {{ form_row(filterForm.status) }}
            {{ form_row(filterForm.category) }}
            {{ form_row(filterForm.assignee) }}

            <div class="filter-actions">
                {# Botón para aplicar los filtros #}
                {{ form_widget(filterForm.filter) }}
                {# Botón para limpiar el formulario refrescando la página del listado #}
                <a class="button button-outline" href="{{ path('app_ticket_index') }}">
                    Limpiar
                </a>
            </div>
        {{ form_end(filterForm) }}
    </section>

    {#
        Mostramos un enlance a el último ticket visitado,
        este código del ticket se recuperó de la sesión.
    #}
    {% if lastTicketCode %}
        <p class="session-note">
            Última incidencia consultada:
            <a href="{{ path('app_ticket_show', { code: lastTicketCode }) }}">{{ lastTicketCode }}</a>
        </p>
    {% endif %}
    
    <div class="ticket-list">
        {# 
            Recorremos la colección de tickets de la página actual 
            El método getItems() devuelve el array de tickets de la página actual
        #}
        {% for ticket in ticketPage.getItems() %}
            {#
                Reutilizamos un fragmento de plantilla para cada tarjeta.
                "only" limita el contexto del fragmento a la variable ticket,
                evitando dependencias ocultas con otras variables de la vista.
            #}
            {% include 'ticket/_ticket_card.html.twig' with {'ticket': ticket} only %}
        {% else %}
            {# Twig ejecuta este bloque si la colección está vacía (no hay tickets) #}
            <p>No hay incidencias disponibles</p>
        {% endfor %}
    </div>

    {# Controles de navegación del paginador #}
    {#
        El método hasToPaginate() verifica si es necesario paginar, esto es, si los
        resultados no caben en una sola página 
    #}
    {% if ticketPage.hasToPaginate() %}
        {# Guardo todos los parámetros actuales de la URL en una variable params #}
        {% set params = app.request.query.all %}

        {# Agrego un elemento nav de HTML #}
        <nav class="pagination">
            {#
                Mostramos el enlace a la página previa sólo si existe una página previa
                Navegamos (refrescamos) la página del listado de tickets, pero cambiamos
                el valor de page por el valor de page - 1, que corresponde a la página anterior
            #}
            {% if ticketPage.hasPreviousPage() %}
                <a
                    class="button button-outline" 
                    href="{{ path('app_ticket_index', params|merge({ page: ticketPage.getPageNumber() - 1 })) }}"
                >
                    ← Anterior
                </a>
            {% endif %}
            <span>
                Página {{ ticketPage.getPageNumber() }} de {{ ticketPage.getPageCount() }}
            </span>
            {#
                Mostramos el enlace a la página siguiente sólo si existe una página siguiente
                Navegamos (refrescamos) la página del listado de tickets, pero cambiamos
                el valor de page por el valor de page + 1, que corresponde a la página siguiente
            #}
            {% if ticketPage.hasNextPage() %}
                <a
                    class="button button-outline" 
                    href="{{ path('app_ticket_index', params|merge({ page: ticketPage.getPageNumber() + 1 })) }}"
                >
                    Siguiente →
                </a>
            {% endif %}
        </nav>
    {% endif %}
    
{% endblock %}