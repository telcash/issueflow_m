{#
    Página 500 centralizada de IssueFlow.
    Plantilla personalizada para errores internos del servidor.
#}
{% extends 'base.html.twig' %}
{% block title %}Error interno - IssueFlow{% endblock %}
{% block body %}
    <section class="error-page">
        <p class="eyebrow">Error 500</p>
        <h1>Algo ha salido mal</h1>
        <p>Se ha producido un error interno en el servidor. Estamos trabajando para solucionarlo.</p>
        <p>
            <a href="{{ path('app_home') }}">Volver al inicio</a>
        </p>
    </section>
{% endblock %}
